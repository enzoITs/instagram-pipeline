# ==========================================================================
# Instagram Pipeline — copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
# O SETUP.md explica onde obter cada credencial.
# ==========================================================================

# --- Credenciais do app da Meta (obrigatórias para conectar contas) --------
# https://developers.facebook.com/apps  ->  seu app
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Fluxo de login:
#   instagram_login  -> o usuário entra com o Instagram, sem Página do Facebook (padrão)
#   facebook_login   -> entra com o Facebook, exige Página vinculada
META_LOGIN_FLOW=instagram_login

# Pede também permissão de leitura de comentários, para que a análise de um
# link de conta conectada use os comentários da API oficial em vez de coleta
# pública. Exige a permissão aprovada no app da Meta.
ENABLE_GRAPH_COMMENTS=false

# --- URL pública (obrigatória) --------------------------------------------
# Precisa ser idêntica ao redirect URI registrado na Meta, que é
# <PUBLIC_BASE_URL>/auth/callback. A Meta exige HTTPS: em desenvolvimento use
#   ngrok http 8000        ->  https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000

# --- Segurança ------------------------------------------------------------
# Assina o state do OAuth, o cookie de sessão e (sem TOKEN_ENCRYPTION_KEY)
# deriva a chave que criptografa os tokens. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Comentado, é gerado e guardado em data/.secret_key (apenas desenvolvimento);
# com ENVIRONMENT=production o app recusa subir sem um valor real.
#SECRET_KEY=

# Criptografa os tokens em repouso. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#TOKEN_ENCRYPTION_KEY=

# Senha do painel. Sem ela NÃO há autenticação: qualquer um que alcance a URL
# vê os dados, dispara coletas e gasta créditos de Apify/OpenAI. Obrigatória
# com ENVIRONMENT=production.
#ADMIN_PASSWORD=
SESSION_MAX_AGE_HOURS=12
LOGIN_ATTEMPTS_PER_MINUTE=5

# Só ative atrás de um proxy confiável (X-Forwarded-For é falsificável).
TRUST_PROXY_HEADERS=false
# Origens extras permitidas por CORS. Vazio = apenas a própria origem.
CORS_ORIGINS=

# --- Banco de dados -------------------------------------------------------
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=instagram_pipeline
# Porta do container no host. Use outra (ex.: 5433) se um PostgreSQL da
# própria máquina já ocupa a 5432 — e a mesma porta no DATABASE_URL abaixo.
POSTGRES_PORT=5432
# Um só driver (psycopg 3) serve o motor síncrono e o assíncrono.
DATABASE_URL=postgresql+psycopg://pipeline:change-me@localhost:5432/instagram_pipeline
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Aplicar migrações no arranque. No compose é false: o container `api` roda
# `alembic upgrade head` antes de subir o servidor.
AUTO_MIGRATE=true

# --- Redis, fila e cache --------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# celery = produção (exige worker). inline = roda dentro da API (apenas testes).
TASK_BACKEND=celery
CELERY_CONCURRENCY=2
# Arquivo onde o beat guarda a última execução de cada tarefa (padrão: pasta temporária).
# CELERY_BEAT_SCHEDULE_FILE=/tmp/instagram-pipeline-celerybeat-schedule
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=10

# --- Coleta das contas conectadas -----------------------------------------
COLLECTION_INTERVAL_MINUTES=360
MAX_MEDIA_PER_COLLECTION=50
API_CALLS_PER_HOUR=180
BUSINESS_USE_CASE_THRESHOLD=80
TOKEN_REFRESH_THRESHOLD_DAYS=10
TOKEN_REFRESH_INTERVAL_HOURS=12
# false desliga todos os jobs periódicos (coleta, renovação, manutenção).
ENABLE_SCHEDULER=true
# Frequência da re-coleta de métricas dos links marcados como "acompanhar".
# 0 desliga.
TRACKING_INTERVAL_MINUTES=720

# --- Análise por link: coleta ---------------------------------------------
# auto = Apify quando houver APIFY_TOKEN, Instaloader como reserva
# apify | instaloader | mock (dados de demonstração, sinalizados no painel)
SCRAPER_MODE=auto
APIFY_TOKEN=
APIFY_TIMEOUT_SECONDS=90
MAX_COMMENTS=500
# Sessão do Instaloader (comentários costumam exigir sessão autenticada)
INSTAGRAM_USERNAME=
INSTAGRAM_SESSIONFILE=

# --- Análise por link: NLP ------------------------------------------------
NLP_BACKEND=transformers           # transformers | lexicon (leve, menos preciso)
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
INTENT_MODEL=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
NLP_INTENT_ZERO_SHOT=true
NLP_BATCH_SIZE=32
NLP_DEVICE=auto                    # auto | cpu | cuda
NLP_TORCH_THREADS=
# Carrega os modelos ao iniciar o processo (apenas o worker da fila `analysis`).
WORKER_PRELOAD_NLP=false

# --- Análise por link: insights com IA ------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT_SECONDS=30

# --- Runtime --------------------------------------------------------------
GRAPH_API_VERSION=v23.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text                    # json em produção
HOST=127.0.0.1
PORT=8000
