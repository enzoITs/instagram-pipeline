# ==========================================================================
# Instagram Pipeline — copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ==========================================================================

# --- Meta app credentials (REQUIRED) --------------------------------------
# Get these at https://developers.facebook.com/apps  ->  your app
#   * instagram_login  -> App settings > Basic (App ID / App Secret) OR
#                         Instagram > API setup with Instagram business login
#   * facebook_login   -> App settings > Basic (App ID / App Secret)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Which login flow to use:
#   instagram_login  -> user signs in with Instagram, no Facebook Page needed (default)
#   facebook_login   -> user signs in with Facebook, requires a linked Page
META_LOGIN_FLOW=instagram_login

# --- Public URL (REQUIRED) ------------------------------------------------
# Must match EXACTLY the redirect URI registered in the Meta app dashboard.
# The app appends /auth/callback to it, so register:  <PUBLIC_BASE_URL>/auth/callback
# Meta requires HTTPS: for local development use a tunnel such as
#   ngrok http 8000        ->  https://xxxx.ngrok-free.app
#   cloudflared tunnel --url http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Security (REQUIRED in production) ------------------------------------
# Signs the OAuth state parameter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is derived from SECRET_KEY (fine for local development).
TOKEN_ENCRYPTION_KEY=

# --- Database -------------------------------------------------------------
# SQLite by default. For PostgreSQL install `psycopg[binary]` and use:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/instagram_pipeline
DATABASE_URL=sqlite:///./data/instagram_pipeline.db

# --- Collection tuning ----------------------------------------------------
# How often the scheduler collects metrics (minutes). 360 = every 6 hours.
COLLECTION_INTERVAL_MINUTES=360
# Most recent posts fetched per run. Each post costs ~1 extra API call.
MAX_MEDIA_PER_COLLECTION=50
# Local ceiling on Graph API calls per hour, kept below Meta's own budget.
API_CALLS_PER_HOUR=180
# Pause collection when Meta reports this % of the call budget already used.
BUSINESS_USE_CASE_THRESHOLD=80
# Set to false to run the API without background jobs (useful for tests/CI).
ENABLE_SCHEDULER=true

# --- Tokens ---------------------------------------------------------------
# Refresh a 60-day token once it is this close to expiring.
TOKEN_REFRESH_THRESHOLD_DAYS=10
TOKEN_REFRESH_INTERVAL_HOURS=12

# --- Runtime --------------------------------------------------------------
GRAPH_API_VERSION=v23.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
