# =============================================================================
# Instagram Engagement Analyzer - environment configuration
# Copy to `.env` (project root for docker compose, or backend/.env for local dev)
# and fill in the secrets. Never commit the real `.env`.
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | text

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=analyzer
# Async driver for the API; the worker/Alembic derive the psycopg2 URL from it.
DATABASE_URL=postgresql+asyncpg://analyzer:change-me@localhost:5432/analyzer
DB_POOL_MIN=5
DB_POOL_MAX=50

# --- Redis / Celery ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX=20
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# celery = production (needs a running worker) | inline = run the pipeline inside the API process (dev only)
TASK_BACKEND=celery
# Worker processes. Each process loads the NLP models (~2 GB RAM).
CELERY_CONCURRENCY=2
CACHE_TTL_SECONDS=86400

# --- API security ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
# Only enable behind a trusted reverse proxy (X-Forwarded-For is spoofable otherwise).
# docker-compose.yml forces it to true because nginx fronts the API there.
TRUST_PROXY_HEADERS=false

# --- Scraping ----------------------------------------------------------------
# auto = Apify when APIFY_TOKEN is set, Instaloader otherwise (and as fallback)
# apify | instaloader | mock (synthetic demo data, clearly flagged in the UI)
SCRAPER_MODE=auto
APIFY_TOKEN=
APIFY_TIMEOUT_SECONDS=90
MAX_COMMENTS=500
# Optional: Instaloader session (comments usually require a logged-in session)
INSTAGRAM_USERNAME=
INSTAGRAM_SESSIONFILE=

# --- NLP ----------------------------------------------------------------
NLP_BACKEND=transformers           # transformers | lexicon (lightweight fallback)
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
INTENT_MODEL=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
NLP_INTENT_ZERO_SHOT=true
NLP_BATCH_SIZE=32
NLP_DEVICE=auto                    # auto | cpu | cuda
# Torch threads per worker process; empty = CPU cores / CELERY_CONCURRENCY
NLP_TORCH_THREADS=

# --- AI insights ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT_SECONDS=30
